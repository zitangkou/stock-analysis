# Cloud data factory
TZ=Asia/Shanghai

# Parquet root (default: ./storage/parquet under this package)
# PARQUET_ROOT=/opt/quant-data-factory/storage/parquet

# Boards: sh.6 / sz.0 / sz.3  (STAR 688 off by default)
INCLUDE_STAR=0

# Sleep between BaoStock symbol requests (seconds)
BAOSTOCK_SLEEP=0.05

# Optional: also upsert daily bars into stock-analysis Postgres
# DATABASE_URL=postgresql://stock:CHANGE_ME@127.0.0.1:5432/stock_market
WRITE_POSTGRES=0

# AKShare extras sleep
AKSHARE_SLEEP=0.4
