[Unit]
Description=A-share quote ingest loop (QUOTE_INTERVAL_SEC, default 60s)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/stock-analysis/collector
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Shanghai
# Prefer collector/.env for DATABASE_URL / QUOTE_INTERVAL_SEC
EnvironmentFile=-/opt/stock-analysis/collector/.env
ExecStart=/opt/stock-analysis/collector/.venv/bin/python -m src.cli run-quotes
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
